  "components": {
    "@layer base": {
      ":where(.dark, .dark *), :where(.dark, .dark *)::before, :where(.dark, .dark *)::after": {
        "border-color": "var(--border, var(--ien-border))"
      }
    },
    "@layer components": {
      ":where(*), :where(*)::before, :where(*)::after": {
        "corner-shape": "var(--ien-control-corner-shape)"
      },
      ":where([data-ien-gradient=\"false\"])": {
        "--ien-gradient": "none"
      },
      ":where([data-ien-gradient=\"true\"])": {
        "--ien-gradient": "initial"
      },
      ":where([data-ien-tone=\"neutral\"])": {
        "--ien-tone-color": "var(--ien-neutral)",
        "--ien-tone-on": "var(--ien-on-neutral)",
        "--ien-tone-weak": "var(--ien-neutral-weak)",
        "--primary": "var(--ien-neutral)",
        "--primary-foreground": "var(--ien-on-neutral)",
        "--ring": "var(--ien-neutral)",
        "--accent": "var(--ien-neutral-weak)",
        "--accent-foreground": "var(--ien-neutral)",
        "--secondary": "var(--ien-neutral-weak)",
        "--secondary-foreground": "var(--ien-neutral)"
      },
      ":where([data-ien-tone=\"brand\"])": {
        "--ien-tone-color": "var(--ien-brand)",
        "--ien-tone-on": "var(--ien-on-brand)",
        "--ien-tone-weak": "var(--ien-brand-weak)",
        "--primary": "var(--ien-brand)",
        "--primary-foreground": "var(--ien-on-brand)",
        "--ring": "var(--ien-brand)",
        "--accent": "var(--ien-brand-weak)",
        "--accent-foreground": "var(--ien-brand)",
        "--secondary": "var(--ien-brand-weak)",
        "--secondary-foreground": "var(--ien-brand)"
      },
      ":where([data-ien-tone=\"success\"])": {
        "--ien-tone-color": "var(--ien-success)",
        "--ien-tone-on": "var(--ien-on-success)",
        "--ien-tone-weak": "var(--ien-success-weak)",
        "--primary": "var(--ien-success)",
        "--primary-foreground": "var(--ien-on-success)",
        "--ring": "var(--ien-success)",
        "--accent": "var(--ien-success-weak)",
        "--accent-foreground": "var(--ien-success)",
        "--secondary": "var(--ien-success-weak)",
        "--secondary-foreground": "var(--ien-success)"
      },
      ":where([data-ien-tone=\"warning\"])": {
        "--ien-tone-color": "var(--ien-warning)",
        "--ien-tone-on": "var(--ien-on-warning)",
        "--ien-tone-weak": "var(--ien-warning-weak)",
        "--primary": "var(--ien-warning)",
        "--primary-foreground": "var(--ien-on-warning)",
        "--ring": "var(--ien-warning)",
        "--accent": "var(--ien-warning-weak)",
        "--accent-foreground": "var(--ien-warning)",
        "--secondary": "var(--ien-warning-weak)",
        "--secondary-foreground": "var(--ien-warning)"
      },
      ":where([data-ien-tone=\"danger\"])": {
        "--ien-tone-color": "var(--ien-danger)",
        "--ien-tone-on": "var(--ien-on-danger)",
        "--ien-tone-weak": "var(--ien-danger-weak)",
        "--primary": "var(--ien-danger)",
        "--primary-foreground": "var(--ien-on-danger)",
        "--ring": "var(--ien-danger)",
        "--accent": "var(--ien-danger-weak)",
        "--accent-foreground": "var(--ien-danger)",
        "--secondary": "var(--ien-danger-weak)",
        "--secondary-foreground": "var(--ien-danger)"
      },
      ":where([data-ien-tone=\"info\"])": {
        "--ien-tone-color": "var(--ien-info)",
        "--ien-tone-on": "var(--ien-on-info)",
        "--ien-tone-weak": "var(--ien-info-weak)",
        "--primary": "var(--ien-info)",
        "--primary-foreground": "var(--ien-on-info)",
        "--ring": "var(--ien-info)",
        "--accent": "var(--ien-info-weak)",
        "--accent-foreground": "var(--ien-info)",
        "--secondary": "var(--ien-info-weak)",
        "--secondary-foreground": "var(--ien-info)"
      },
      ":where([data-ien-typography=\"display\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-display)"
      },
      ":where([data-ien-typography=\"title1\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-title1)"
      },
      ":where([data-ien-typography=\"title2\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-title2)"
      },
      ":where([data-ien-typography=\"title3\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-title3)"
      },
      ":where([data-ien-typography=\"body1\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-body1)"
      },
      ":where([data-ien-typography=\"body2\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-body2)"
      },
      ":where([data-ien-typography=\"label1\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-label1)"
      },
      ":where([data-ien-typography=\"label2\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-label2)"
      },
      ":where([data-ien-typography=\"caption\"])": {
        "font-family": "var(--ien-font-sans)",
        "font-weight": "var(--ien-font-weight-caption)"
      },
      ".ien-fill": {
        "background-color": "var(--ien-control-color)",
        "color": "var(--ien-control-on)",
        "border-color": "transparent",
        "background-image": "var(--ien-gradient, linear-gradient(135deg, color-mix(in srgb, var(--ien-control-color), var(--ien-control-on) 18%), var(--ien-control-color), color-mix(in srgb, var(--ien-control-color), var(--ien-control-on) 36%)))"
      },
      ".ien-weak": {
        "background-color": "var(--ien-control-weak)",
        "color": "var(--ien-control-color)",
        "border-color": "transparent",
        "background-image": "var(--ien-gradient, linear-gradient(135deg, color-mix(in srgb, var(--ien-control-weak), var(--ien-control-color) 6%), var(--ien-control-weak), color-mix(in srgb, var(--ien-control-weak), var(--ien-control-color) 10%)))"
      },
      ".ien-outline": {
        "background-color": "transparent",
        "color": "var(--ien-control-color)",
        "border-color": "var(--ien-control-color)",
        "background-image": "none"
      },
      ".ien-clear": {
        "border-color": "transparent",
        "background-color": "transparent",
        "color": "var(--ien-control-color)",
        "background-image": "none"
      },
      ":where(.ien-fill, .ien-weak, .ien-outline, .ien-clear):is(button, a, [role=\"button\"]):not(:disabled, [data-disabled], [aria-disabled=\"true\"]):hover": {
        "filter": "brightness(0.96)"
      },
      ":where([data-slot=\"button\"]):not(:disabled, [aria-disabled=\"true\"]):active": {
        "transform": "scale(var(--ien-button-pressed-scale))",
        "transition-duration": "var(--ien-button-press-duration)",
        "transition-timing-function": "var(--ien-button-press-easing)"
      },
      ":where([data-slot=\"tabs-trigger\"][data-state=\"active\"])": {
        "background-color": "transparent",
        "color": "var(--ien-text-primary)",
        "background-image": "none"
      },
      ":where([data-slot=\"separator\"][data-ien-tone], [data-slot=\"scroll-area-thumb\"])": {
        "background-color": "var(--ien-tone-color, var(--ien-border))"
      },
      ":where([data-slot=\"avatar-fallback\"][data-ien-tone])": {
        "background-color": "var(--ien-control-weak)",
        "color": "var(--ien-control-color)",
        "background-image": "var(--ien-gradient, linear-gradient(135deg, color-mix(in srgb, var(--ien-control-weak), var(--ien-control-color) 6%), var(--ien-control-weak), color-mix(in srgb, var(--ien-control-weak), var(--ien-control-color) 10%)))"
      },
      ":where([data-slot=\"progress-indicator\"][data-ien-tone], [data-slot=\"label\"][data-ien-tone], [data-slot=\"rating\"][data-ien-tone])": {
        "color": "var(--ien-control-color)"
      },
      ":where([data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"select-trigger\"], [data-slot=\"input-group\"])[data-ien-tone]:not([aria-invalid=\"true\"]):focus-within": {
        "border-color": "var(--ien-control-color)"
      },
      ":where([data-ien], .ien-fill, .ien-weak, .ien-outline, .ien-clear)": {
        "--ien-control-color": "var(--ien-tone-color, var(--ien-brand))",
        "--ien-control-on": "var(--ien-tone-on, var(--ien-on-brand))",
        "--ien-control-weak": "var(--ien-tone-weak, var(--ien-brand-weak))",
        "transition-duration": "var(--ien-motion-fast)",
        "transition-timing-function": "var(--ien-motion-standard-easing)",
        "background-origin": "border-box",
        "background-repeat": "no-repeat"
      },
      ":where(.ien-clear):not(:disabled, [data-disabled], [aria-disabled=\"true\"]):hover": {
        "background-color": "var(--ien-control-weak)"
      },
      ":where([data-ien][class~=\"bg-primary\"])": {
        "background-image": "var(--ien-gradient, linear-gradient(135deg, color-mix(in srgb, var(--primary), var(--primary-foreground) 18%), var(--primary), color-mix(in srgb, var(--primary), var(--primary-foreground) 36%)))"
      },
      ":where([data-slot=\"stepper-indicator\"]):is([data-state=\"active\"], [data-state=\"completed\"])": {
        "background-image": "var(--ien-gradient, linear-gradient(135deg, color-mix(in srgb, var(--ien-control-color), var(--ien-control-on) 18%), var(--ien-control-color), color-mix(in srgb, var(--ien-control-color), var(--ien-control-on) 36%)))"
      },
      ":where([data-slot=\"tabs-list\"][data-variant=\"line\"]) :where([data-slot=\"tabs-trigger\"])": {
        "background-image": "none"
      },
      ":where([data-slot=\"empty-media\"][data-ien-tone])": {
        "color": "var(--ien-control-color)",
        "background-color": "var(--ien-control-weak)"
      },
      ":where([data-skeleton-motion])": {
        "animation-name": "ien-skeleton-wave",
        "animation-duration": "1200ms",
        "animation-iteration-count": "infinite",
        "animation-delay": "var(--ien-skeleton-delay, -1200ms)",
        "animation-timing-function": "linear(0.5000000, 0.5652631, 0.6294095, 0.6913417, 0.7500000, 0.8043807, 0.8535534, 0.8966767, 0.9330127, 0.9619398, 0.9829629, 0.9957224, 1.0000000, 0.9957224, 0.9829629, 0.9619398, 0.9330127, 0.8966767, 0.8535534, 0.8043807, 0.7500000, 0.6913417, 0.6294095, 0.5652631, 0.5000000, 0.4347369, 0.3705905, 0.3086583, 0.2500000, 0.1956193, 0.1464466, 0.1033233, 0.0669873, 0.0380602, 0.0170371, 0.0042776, 0.0000000, 0.0042776, 0.0170371, 0.0380602, 0.0669873, 0.1033233, 0.1464466, 0.1956193, 0.2500000, 0.3086583, 0.3705905, 0.4347369, 0.5000000)",
        "transform-origin": "center"
      },
      ".ien-pull-to-refresh-dot": {
        "animation": "ien-pull-to-refresh-dot 900ms linear infinite"
      },
      ":where([data-slot=\"button\"])[data-ien-disabled=\"true\"]": {
        "color": "var(--ien-text-disabled)",
        "background-image": "none",
        "border-color": "transparent",
        "background-color": "var(--ien-surface-variant)"
      },
      ":where([data-slot=\"button\"])[data-ien-disabled=\"true\"]:is([data-variant=\"line\"], [data-variant=\"ghost\"])": {
        "background-color": "transparent"
      },
      ":where([data-slot=\"button\"])[data-ien-disabled=\"true\"][data-variant=\"line\"]": {
        "border-color": "var(--ien-border)"
      },
      ":where([data-slot=\"button\"]):not([aria-disabled=\"true\"]):active": {
        "box-shadow": "inset 0 0 0 100vmax rgb(0 0 0 / 8%)"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":where([data-ien])": {
        "transition-duration": "0ms",
        "animation-duration": "0ms"
      },
      ":where([data-slot=\"button\"]):active": {
        "transform": "none"
      },
      ":where([data-skeleton-motion])": {
        "animation": "none",
        "opacity": "1",
        "transform": "none"
      },
      ".ien-pull-to-refresh-dot": {
        "animation": "none",
        "opacity": "1",
        "transform": "none"
      }
    },
    "@keyframes ien-skeleton-wave": {
      "from": {
        "opacity": "0.2",
        "transform": "scale(0.96)"
      },
      "to": {
        "opacity": "1",
        "transform": "scale(1)"
      }
    },
    "@keyframes ien-pull-to-refresh-dot": {
      "0%, 65%, 100%": {
        "transform": "translateY(0) scale(0.72)",
        "opacity": "0.55"
      },
      "35%": {
        "transform": "translateY(-6px) scale(1.18)",
        "opacity": "1",
        "animation-timing-function": "var(--ien-motion-standard-easing)"
      },
      "0%": {
        "animation-timing-function": "var(--ien-motion-standard-easing)"
      }
    }
  }
}
