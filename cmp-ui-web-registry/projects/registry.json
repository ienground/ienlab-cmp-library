{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "ienlab",
      "title": "IENLAB",
      "description": "기존 IEN 웹 컴포넌트의 반경과 글자 크기를 유지하는 기본 프로젝트입니다.",
      "registryDependencies": [
        "@ienlab/ien-theme"
      ],
      "cssVars": {
        "theme": {},
        "light": {
          "ien-radius-none": "0rem",
          "ien-radius-xs": "0.25rem",
          "ien-radius-sm": "0.5rem",
          "ien-radius-default": "0.75rem",
          "ien-radius-md": "0.75rem",
          "ien-radius-lg": "1rem",
          "ien-radius-xl": "1.5rem",
          "ien-radius-full": "62.4375rem"
        },
        "dark": {}
      },
      "css": {},
      "meta": {
        "order": 0
      },
      "type": "registry:base",
      "config": {
        "style": "radix-nova",
        "tailwind": {
          "baseColor": "neutral",
          "cssVariables": true
        },
        "iconLibrary": "lucide",
        "aliases": {
          "components": "@/components",
          "utils": "@/lib/utils",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks"
        },
        "registries": {
          "@ienlab": "https://cmp.ien.zone/r/{name}.json"
        }
      }
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "ienlab-microsite",
      "title": "ienlab-microsite",
      "description": "아이엔랩 Microsite + 콘솔",
      "registryDependencies": [
        "@ienlab/ien-theme"
      ],
      "cssVars": {
        "theme": {
          "ien-button-shape": "capsule"
        },
        "light": {
          "ien-radius-none": "0rem",
          "ien-radius-xs": "0.25rem",
          "ien-radius-sm": "0.5rem",
          "ien-radius-default": "0.75rem",
          "ien-radius-md": "0.75rem",
          "ien-radius-lg": "1rem",
          "ien-radius-xl": "1.5rem",
          "ien-radius-full": "62.4375rem",
          "ien-brand": "#7C4DFF",
          "ien-on-brand": "#FFFFFF"
        },
        "dark": {
          "ien-brand": "#7C4DFF",
          "ien-on-brand": "#FFFFFF"
        }
      },
      "css": {},
      "meta": {},
      "type": "registry:base",
      "config": {
        "style": "radix-nova",
        "tailwind": {
          "baseColor": "neutral",
          "cssVariables": true
        },
        "iconLibrary": "tabler",
        "aliases": {
          "components": "@/components",
          "utils": "@/lib/utils",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks"
        },
        "registries": {
          "@ienlab": "https://cmp.ien.zone/r/{name}.json"
        }
      }
    }
  ]
}
