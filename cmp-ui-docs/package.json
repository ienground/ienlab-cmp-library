{
  "name": "cmp-ui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build:compose": "../gradlew :cmp-ui-docs:wasmJsBrowserDistribution --no-configuration-cache",
    "dev": "npm run build:compose && npm run generate:api && npm run typecheck && npm run copy:compose && vite --host 0.0.0.0 --port 4800",
    "generate:api": "node scripts/generate-api-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run generate:api && node --test web/color-scheme.test.ts",
    "build": "npm run generate:api && npm run typecheck && vite build",
    "copy:compose": "node scripts/copy-compose-preview.mjs",
    "build:site": "npm run build && npm run copy:compose"
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
