{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "web/**/*.d.ts",
    "../cmp-ui-web-registry/**/*.ts",
    "../cmp-ui-web-registry/**/*.tsx"
  ],
  "extends": "./tsconfig.registry.json"
}
